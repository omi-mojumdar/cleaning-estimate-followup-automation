    {
      "parameters": {
        "jsCode": "const today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nconst rows = $input.all();\n\nconst toProcess = rows.filter(row => {\n  const status = row.json['Status'];\n  const optOut = row.json['Opt-Out'];\n  const nextFollowUp = new Date(row.json['Next Follow-up Date']);\n  nextFollowUp.setHours(0, 0, 0, 0);\n\n  return (\n    status === 'Pending' &&\n    optOut === 'No' &&\n    nextFollowUp <= today\n  );\n});\n\nreturn toProcess;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
