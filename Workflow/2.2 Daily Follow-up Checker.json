        "sendTo": "tirthomoj@gmail.com",
        "subject": "Following up on your cleaning estimate",
        "emailType": "text",
        "message": "=Hi {{ $json[\"Customer Name\"] }},\n\nJust following up on the estimate we sent you for a \n{{ $json[\"Service Type\"] }} \n({{ $json[\"Bedrooms\"] }} bed / {{ $json[\"Bathrooms\"] }} bath).\n\nYour estimate total: ${{ $json[\"Estimate Amount\"] }}\n\nWe'd love to get you booked in. Simply reply to this \nemail to confirm your appointment.\n\nIf you have any questions, we're happy to help.\n\nBest regards,\nSparkle Clean Team\n\n---\nReply STOP to opt out of follow-up emails.",
        "options": {
