    {
      "parameters": {
        "jsCode": "const today = new Date();\n\n// Get original data from the filter Code node\nconst originalData = $('Code in JavaScript').item.json;\nconst count = parseInt(originalData['Follow-up Count']) + 1;\n\n// Gap: after 1st follow-up wait 3 days, after 2nd wait 5 days\nconst daysToAdd = count === 1 ? 3 : 5;\n\nconst nextDate = new Date(today);\nnextDate.setDate(today.getDate() + daysToAdd);\n\nreturn [{\n  json: {\n    rowNumber: originalData['row_number'],\n    estimateId: originalData['Estimate ID'],\n    followUpCount: count,\n    lastFollowUpDate: today.toISOString().split('T')[0],\n    nextFollowUpDate: nextDate.toISOString().split('T')[0]\n  }\n}];"
      },
